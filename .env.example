# =============================================================================
# Masaram Gondi Dictionary — environment template
# Copy to .env.local and fill values. NEVER commit .env.local
# =============================================================================

# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Masaram Gondi Dictionary

# --- Server only (NEVER expose to the client) ---
# Service role key: server-side / serverless only. Do not prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Local / demo admin (used only when Supabase Auth is not configured)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=replace-with-64-char-random-string

# Optional Upstash Redis rate limiting (falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: persist admin Save/Delete on Vercel (GitHub Contents: Read and write)
# Create a fine-grained PAT, add it in Vercel Environment Variables, Redeploy.
GITHUB_STORE_TOKEN=
GITHUB_STORE_REPO=aimanage750/masaram-gondi-dictionary
GITHUB_STORE_BRANCH=data-store

# Audio upload limits
MAX_AUDIO_BYTES=5242880

# --- Contact form (server-only; never use NEXT_PUBLIC_ prefix) ---
# Resend API key. Keep this secret and set it in Vercel Production/Preview as needed.
RESEND_API_KEY=
# Destination inbox for contact messages.
CONTACT_TO_EMAIL=sevajoharsaiyyam@gmail.com
# Verified sender identity in Resend, e.g. "Masaram Gondi Platform <contact@your-domain>"
CONTACT_FROM_EMAIL=

# --- Phase 9: secure Admin Panel (Google OAuth) ---
# Google OAuth credentials (server-side only — the secret never ships to the client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the admin session cookie (falls back to ADMIN_SESSION_SECRET when unset)
AUTH_SECRET=
# Server-side admin allowlists (comma-separated emails). Google login alone
# NEVER grants access — the email must appear in one of these lists.
ADMIN_EMAILS=
ADMIN_EDITOR_EMAILS=
ADMIN_REVIEWER_EMAILS=
# Development-only sign-in (disabled unless NODE_ENV != production AND =1)
ADMIN_DEV_LOGIN=0
